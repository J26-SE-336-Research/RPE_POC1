# Copy this file to .env before running docker compose.
# .env itself should never be committed to version control.

POSTGRES_USER=rrpe_admin
POSTGRES_PASSWORD=change_this_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

ORDER_DB=orderdb
INVENTORY_DB=inventorydb
PAYMENT_DB=paymentdb

ORDER_SERVICE_PORT=8081
INVENTORY_SERVICE_PORT=8082
PAYMENT_SERVICE_PORT=8083
NOTIFICATION_SERVICE_PORT=8084
API_GATEWAY_PORT=8080

# Simulated payment failure rate (0.0 - 1.0), used by payment-service
# to make retry/backoff scenarios demonstrable without external dependencies.
PAYMENT_SIMULATED_FAILURE_RATE=0.15
